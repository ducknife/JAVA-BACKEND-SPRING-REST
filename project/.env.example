# Copy file này thành .env rồi điền giá trị thật vào — .env không được commit lên git.
# Đây là template, giá trị ở đây chỉ mang tính minh hoạ / giá trị mặc định an toàn.

# Server
PORT=8080

# Database — dùng cho application-dev.yml (có default nên có thể để trống khi dev local)
DB_USERNAME=root
DB_PASSWORD=

# Database — chỉ bắt buộc khi chạy profile prod (application-prod.yml, không có default)
MYSQL_URI=jdbc:mysql://HOST:3306/DB_NAME

# JWT
issuer=ducknife
JWT_SECRET_KEY=

# Admin bootstrap (tài khoản admin đầu tiên lúc khởi động)
ADMIN_FULLNAME=Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com
ADMIN_ROLES=ROLE_ADMIN,ROLE_COLLABORATOR

# Google OAuth2 — lấy tại https://console.cloud.google.com -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth2 — lấy tại https://github.com/settings/developers -> OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cors 
ALLOWED_METHODS=
ALLOWED_ORIGINS=
ALLOWED_HEADERS=
ALLOW_CREDENTIALS=

# Frontend Url Callback 
FRONTEND_URL_CALLBACK=
